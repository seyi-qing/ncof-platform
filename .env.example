# Application
APP_ENV=development
# Use production on Vercel Production environment

# Neon / PostgreSQL (psycopg3). Vercel/Neon often give postgres:// — the app normalizes it.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# Must be unique, long random strings (32+ chars each) in production
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
PAYMENT_WEBHOOK_SECRET=replace-with-a-different-long-random-secret
AUDIT_HASH_SECRET=replace-with-another-different-long-random-secret

# Provider secrets (set only for gateways you use)
# Paystack: secret key from dashboard (sk_test_... / sk_live_...)
PAYSTACK_SECRET_KEY=
# Flutterwave: secret hash you configure under Settings → Webhooks
FLW_SECRET_HASH=

# Comma-separated frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000

# Optional tuning
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=30
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# LOAN_MAX_AMOUNT=10000000.00
# WITHDRAWAL_MAX_AMOUNT=5000000.00
